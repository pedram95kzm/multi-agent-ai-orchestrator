{
  "manifest_version": 3,
  "name": "Relay Chrome Connection",
  "version": "1.1.8",
  "description": "Connect Relay task chats to tabs in your current signed-in Chrome profile.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.z.ai/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Relay Chrome Connection"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  }
}
